{
  "name": "IceGraph",
  "short_name": "IceGraph",
  "description": "Interactive, read-only debugger and visualizer for Apache Iceberg table metadata.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#05080f",
  "theme_color": "#05080f",
  "icons": [
    { "src": "./favicon-32.png", "sizes": "32x32", "type": "image/png" },
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
